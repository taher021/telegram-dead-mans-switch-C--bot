[Unit]
Description=Telegram Dead Man's Switch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deadswitch
Group=deadswitch
WorkingDirectory=/opt/deadswitch
ExecStart=/opt/deadswitch/deadswitch --config /opt/deadswitch/config.json --state /opt/deadswitch/state.json
Restart=always
RestartSec=10
TimeoutStopSec=60

# Extra safety: the program may only write inside its own folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deadswitch

[Install]
WantedBy=multi-user.target
